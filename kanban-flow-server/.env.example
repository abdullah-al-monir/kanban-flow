# Postgres connection used by Prisma (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://kanban:kanban_password@localhost:5432/kanban_db?schema=public"

# App
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
DATABASE_URL_UNPOOLED="neon://neondb_owner:neon_password@ep-cold-sun-ae9htmzz.c-2.us-east-2.aws.neon.tech/neondb"
NEON_BRANCH=production