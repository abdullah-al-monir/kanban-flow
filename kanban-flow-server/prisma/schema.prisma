datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum BoardRole {
  OWNER    // Full board administration, including deletion and role assignments
  ADMIN    // Manage columns, settings, and board members
  EDITOR   // Create, move, edit, and delete tasks/columns
  VIEWER   // Read-only access to board assets
}

enum ActivityType {
  TASK_CREATED
  TASK_MOVED
  TASK_UPDATED
  TASK_ARCHIVED
  TASK_DELETED
  BOARD_UPDATED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_REORDERED
  COLUMN_DELETED
  MEMBER_ADDED
  MEMBER_REMOVED
}

// ==========================================
// CORE ENTITIES
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  boardMemberships BoardMember[]
  createdTasks     Task[]         @relation("TaskCreator")
  assignedTasks    Task[]         @relation("TaskAssignee")
  activities       ActivityLog[]

  @@map("users")
}

model Board {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(150)
  description String?   @db.Text
  ownerId     String    @map("owner_id")
  isArchived  Boolean   @default(false) @map("is_archived") // Soft delete pattern
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  members     BoardMember[]
  columns     Column[]
  labels      Label[]
  activities  ActivityLog[]

  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid())
  boardId   String    @map("board_id")
  userId    String    @map("user_id")
  role      BoardRole @default(EDITOR)
  joinedAt  DateTime  @default(now()) @map("joined_at")

  // Relations
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One user cannot have duplicate memberships on the same board
  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  title     String   @db.VarChar(100)
  position  Float    // Fractional index for low-overhead reordering
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId, position])
  @@map("columns")
}

model Task {
  id          String    @id @default(uuid())
  columnId    String    @map("column_id")
  creatorId   String    @map("creator_id")
  assigneeId  String?   @map("assignee_id")
  title       String    @db.VarChar(255)
  description String?   @db.Text
  position    Float     // Fractional index for drag-and-drop sorting
  dueDate     DateTime? @map("due_date")
  isArchived  Boolean   @default(false) @map("is_archived")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  column      Column        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator     User          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels      TaskLabel[]
  activities  ActivityLog[]

  @@index([columnId, position])
  @@index([assigneeId])
  @@map("tasks")
}

// ==========================================
// METADATA & ORGANIZATIONAL ENTITIES
// ==========================================

model Label {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  name      String   @db.VarChar(50)
  colorHex  String   @map("color_hex") @db.VarChar(7) // e.g., #EF4444

  // Relations
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@map("labels")
}

// Junction table for Many-to-Many relationship between Tasks and Labels
model TaskLabel {
  taskId   String @map("task_id")
  labelId  String @map("label_id")

  // Relations
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label    Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model ActivityLog {
  id        String       @id @default(uuid())
  boardId   String       @map("board_id")
  taskId    String?      @map("task_id")
  userId    String       @map("user_id")
  type      ActivityType
  payload   Json?        // Stores dynamic metadata (e.g., { "fromColumn": "To Do", "toColumn": "Done" })
  createdAt DateTime     @default(now()) @map("created_at")

  // Relations
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
  @@map("activity_logs")
}
